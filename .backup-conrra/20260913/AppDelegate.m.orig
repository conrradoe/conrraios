}



-(void ) handleTripRunninNotification:(NSString *) tripId message:(NSString *) message tripStatus:(NSString *)tripStatus{
    UIAlertController *alertController = [UIAlertController alertControllerWithTitle:[LanguageHelper getStringWithKey:@"k_com_s_18_trip_status"]
                                                                             message:message                                                                         preferredStyle:UIAlertControllerStyleAlert];
    UIAlertAction *actionOkCancel = [UIAlertAction actionWithTitle:[LanguageHelper getStringWithKey:@"k_18_s4_Ok"]
                                                             style:UIAlertActionStyleDefault
                                                           handler:^(UIAlertAction * _Nonnull action) {
        [self->autoHideTripStatus performAction];
    }];
    [alertController addAction:actionOkCancel];
    BOOL isCanOpen=YES;
    NSString *trip=defaults_object(TRIP_ID);
    if(trip.length > 0){
        if(![tripStatus isEqualToString:tripId]){
          //  isCanOpen=NO;
        }
    }
    if(isCanOpen){
        [self presentViewControllerCustom:alertController];
        autoHideTripStatus=[[AutoHideAlert alloc] init];
        [autoHideTripStatus handle:alertController];
        autoHideTripStatus.tripId=tripId;
        autoHideTripStatus.tripStatus=tripStatus;
        autoHideTripStatus.delegate=self;
    }
    
     
//    }
}
-(void) presentViewControllerCustom:(UIAlertController *)alertVc{
    if([self.navigationController.topViewController isKindOfClass:[UIAlertController class]]){
        [self.navigationController.topViewController dismissViewControllerAnimated:NO completion:^{
            [self.navigationController.topViewController presentViewController:alertVc animated:YES completion:nil];
        }];
    }else{
        [self.navigationController.topViewController presentViewController:alertVc animated:YES completion:nil];
    }
}
#pragma - mark
-(void)onAutoHide:(AutoHideAlert *)autoHideAlertHelper{
    if(autoHideAlertHelper == autoHideTripStatus){
        for (UIViewController * vc in self.navigationController.viewControllers){
            if([vc isKindOfClass:[HomeViewController class]]){
                [((HomeViewController *)vc) refreshTripStatusRefresh:autoHideTripStatus.tripId tripStatus:autoHideTripStatus.tripStatus];
            }
        }
        autoHideTripStatus=nil;
    }
}
@end
