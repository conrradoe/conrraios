-(id) getSockethelperSwift{
    return socketHelperSwift;
}


-(void) connectToSocket{
    NSDictionary * dict=defaults_object(P_USER_DICT);
    if(dict){
        SocketHelperSwift * socketHelper = [APP_DELEGATE getSockethelperSwift];
        if(![socketHelper isConnected]){
            [socketHelper connect];
        }
    }
}
-(void) disconnectToSocket{
    NSDictionary * dict=defaults_object(P_USER_DICT);
    if(dict){
        SocketHelperSwift * socketHelper = [APP_DELEGATE getSockethelperSwift];
        if([socketHelper isConnected]){
            [socketHelper disconnect];
        }
    }
}


-(NSString * ) getGoogleKey{
    NSString * googleKey=defaults_object(@"google_key_server");
    if(googleKey.length>0)
    {
        return googleKey;
    }
    return @"";
}

- (BOOL)application:(UIApplication *)application didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {
#if DEBUG
    [[NSBundle bundleWithPath:@"/Applications/InjectionIII.app/Contents/Resources/iOSInjection.bundle"] load];
#endif
    self.notificationCount= 0;
//    [[FBSDKSettings sharedSettings] enableLoggingBehavior:FBSDKLoggingBehaviorAppEvents];
//    [[FBSDKAppEvents shared] activateApp];
//    [[FBSDKApplicationDelegate sharedInstance] application:application
//                             didFinishLaunchingWithOptions:launchOptions];
    defaults_set_object(ABU,BASE_URL_DRIVER);
    defaults_set_object(@"EN_IV", IV);
    defaults_set_object(@"EN_KEY", KEY);
    [GIKCommon enabledEn:YES];
    pushNotificationHandler = [[AppPushNotificationHandler alloc] init];
    socketHelperSwift =[[SocketHelperSwift alloc] init];
    [UIApplication sharedApplication].idleTimerDisabled = YES;
    [IQKeyboardManager.sharedManager setLayoutIfNeededOnUpdate:YES];
    [DataBase setUpRoutTrack];
    if([[[NSUserDefaults standardUserDefaults]   objectForKey:P_IS_SINGLE_MODE] boolValue])
    {
        NSString *status =defaults_object(DRIVER_STATUS);
        if ( status ==nil ||[status isEqualToString:TS_WAITING] || [status isEqualToString:TS_REQUEST] || [status isEqualToString:TS_END] || [status isEqualToString:TS_DRIVER_CANCEL_AT_PICKUP] || [status isEqualToString:TS_DRIVER_CANCEL_AT_DROP]){
            
        }
        else {
            
        }
        
    }
    
    if (@available(iOS 13, *)) {
        if([[ConstantModel getConstantsObject] getCValueFK:ckey_etld]){
            if (@available(iOS 13, *)) {
                NSString * uiOri=defaults_object(@"app_mode");
                if(uiOri&&[uiOri isEqualToString:@"light"]){
                    self.window.overrideUserInterfaceStyle = UIUserInterfaceStyleLight;
                }else  if(uiOri&&[uiOri isEqualToString:@"dark"]){
                    self.window.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
                }else  if(uiOri&&[uiOri isEqualToString:@"auto"]){
                    NSDate *date = [NSDate date];
                    NSCalendar *calendar = [NSCalendar currentCalendar];
                    NSDateComponents *components = [calendar components:(NSCalendarUnitHour | NSCalendarUnitMinute) fromDate:date];
                    NSInteger hour = [components hour];
                    if(hour<=DAY_START_HURS){
                        self.window.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
                    }else if(hour>DAY_START_HURS&&hour<DAY_END_HURS){
                        self.window.overrideUserInterfaceStyle = UIUserInterfaceStyleLight;
                    }else{
                        self.window.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;
                    }
                }else{
                    self.window.overrideUserInterfaceStyle = UIUserInterfaceStyleLight;
                }
            }
        }else{
            self.window.overrideUserInterfaceStyle = UIUserInterfaceStyleLight;
        }
    }
   
    if (launchOptions != nil){
        NSDictionary* userInfo = [launchOptions objectForKey:UIApplicationLaunchOptionsRemoteNotificationKey];
        if (userInfo != nil){
            self.userInfoAppLaunch =[self mapUserInfoFcmToApns:userInfo];
        }
    }
    
    UNUserNotificationCenter *center = [UNUserNotificationCenter currentNotificationCenter];
    center.delegate = self;
    [center requestAuthorizationWithOptions:(UNAuthorizationOptionSound | UNAuthorizationOptionAlert | UNAuthorizationOptionBadge) completionHandler:^(BOOL granted, NSError * _Nullable error) {
        if( !error ) {
            // required to get the app to do anything at all about push notifications
            dispatch_async(dispatch_get_main_queue(), ^{
                [[UIApplication sharedApplication] registerForRemoteNotifications];
            });
            
            
        } else {
            
        }
    }];
    [FIRApp configure];
    [FIRMessaging messaging].delegate = self;
    [self getDeviceToken];
    NSDictionary *notification = [launchOptions objectForKey:UIApplicationLaunchOptionsRemoteNotificationKey];
    if (notification) {
        appLaunched = YES;
    } else {         
        appLaunched = NO;
    }
    [self startTimer];
     

    return YES;
}

-(void) stopRequestSound{
    @try {
        if(completeSoundRequest>0) {
            AudioServicesDisposeSystemSoundID(completeSoundRequest);
            completeSoundRequest=0;
        }
    } @catch (NSException *exception) {
        [self openAlertNotificationDebug:[NSString stringWithFormat:@"%@",exception] ];
    } @finally {
        
    }
}

