-(NSDictionary *)mapUserInfoFcmToApns:(NSDictionary *)userInfoFCM{
    NSMutableDictionary *userInfo=[[NSMutableDictionary alloc] init];
    @try {
        NSMutableDictionary *apns=[[NSMutableDictionary alloc] init];
        NSDictionary *dictAlert =[[userInfoFCM objectForKey:@"aps"] objectForKey:@"alert"];
        if ([dictAlert isKindOfClass: [NSDictionary class]]){
            [apns setObject:isEmpty([dictAlert objectForKey:@"body"]) forKey:@"alert"];
            //            [apns setObject:isEmpty([userInfoFCM objectForKey:@"gcm.notification.trip_id"]) forKey:@"trip_id"];
            //            [apns setObject:isEmpty([userInfoFCM objectForKey:@"gcm.notification.trip_status"]) forKey:@"trip_status"];
            NSString *tripId =[userInfoFCM objectForKey:@"trip_id"];
            if(tripId.length>0){
                [apns setObject:isEmpty([userInfoFCM objectForKey:@"trip_id"]) forKey:@"trip_id"];
                [apns setObject:isEmpty([userInfoFCM objectForKey:@"trip_status"]) forKey:@"trip_status"];
                [apns setObject:isEmpty([userInfoFCM objectForKey:@"to"]) forKey:@"to"];
                
            }else{
                [apns setObject:isEmpty([userInfoFCM objectForKey:@"gcm.notification.to"]) forKey:@"to"];
                [apns setObject:isEmpty([userInfoFCM objectForKey:@"gcm.notification.trip_id"]) forKey:@"trip_id"];
                [apns setObject:isEmpty([userInfoFCM objectForKey:@"gcm.notification.trip_status"]) forKey:@"trip_status"];
            }
            
            [apns setObject:isEmpty([userInfoFCM objectForKey:@"google.c.a.e"]) forKey:@"content-available"];
            NSString *type=[userInfoFCM objectForKey:@"gcm.notification.type"];
            if(type.length>0){
                [apns setObject:isEmpty(type) forKey:@"type"];
            }else{
                NSString *type1=[userInfoFCM objectForKey:@"type"];
                if(type1.length>0){
                    [apns setObject:isEmpty(type1) forKey:@"type"];
                }
            }
        }
        
        NSString * dataObject=[userInfoFCM  objectForKey:@"data"];
        if(dataObject) {
            NSError *jsonError;
            NSData *objectData = [dataObject dataUsingEncoding:NSUTF8StringEncoding];
            NSDictionary *dataDict = [NSJSONSerialization JSONObjectWithData:objectData
                                                                     options:NSJSONReadingMutableContainers
                                                                       error:&jsonError];
            if(dataDict){
                [apns setObject:dataDict forKey:@"data"];
            }
        }
        [userInfo setObject:apns forKey:@"aps"];
        return userInfo;
    } @catch (NSException *exception) {
        
    } @finally {
        
    }
    return userInfoFCM;
}

- (void)onDriverSwitchButtonTap:(id)sender {
    NSString *tripId= defaults_object(TRIP_ID);
    if([tripId intValue ]>0){
        [self showAlertWithMessgae:[LanguageHelper getStringWithKey:@"k_67_s4_cnt_switch_drng_trp" defaultValue:@"Can't switch apps during trip"]];
        return;
    }
    BOOL is_user_login = [defaults_object(P_IS_USER_LOGIN) boolValue];
    if(is_user_login){
        NSDictionary * dictLoggedUser=defaults_object(P_USER_DICT_LOGGED);
        NSMutableDictionary * dict=[[NSMutableDictionary alloc] init];
        [dict setObject:isEmpty([dictLoggedUser objectForKey:P_U_MOBILE]) forKey:P_MOBILE];
        [dict setObject:isEmpty([dictLoggedUser objectForKey:P_C_CODE]) forKey:P_C_CODE];
        [self loginAsDriver:dict];
    }else{
        [UtilityClass setLH:NO wt:[LanguageHelper getStringWithKey:@"k_r30_s3_loading"]];
        [[UpdateUserCurrentLocation sharedInstance]  updateDriverActivityLogAvailablity:@"0" type:@"Logout" completionBlock:^(id results, NSError *error) {
            [UtilityClass setLH:YES wt:[LanguageHelper getStringWithKey:@"k_r30_s3_loading"]];
            if(results!=nil) {
                NSDictionary * dictLoggedUser=defaults_object(P_USER_DICT_LOGGED);
                defaults_set_object(P_USER_DICT, dictLoggedUser);
                defaults_set_object(P_API_KEY, [dictLoggedUser objectForKey:P_API_KEY]);
                [self getUserProfile];
            }
        }];
    }
}


-(void) loginAsDriver:(NSDictionary *)dict{
    [UtilityClass setLH:NO wt:[LanguageHelper getStringWithKey:@"k_r30_s3_loading"]];
    [GIC mkwerwu:DRIVER_PH_SIGNIN
               d:dict
              cb:^(id results, NSError *error) {
        if ([[[results objectForKey:P_STATUS] uppercaseString] isEqualToString:@"OK"]) {
            NSObject * userDictObject=[results objectForKey:@"response"];
            if([userDictObject isKindOfClass:[NSDictionary class]]){
                NSDictionary *userDict =(NSDictionary *)userDictObject;
                BOOL isVerified=[[userDict objectForKey:P_DRIVER_VERIFIED] boolValue];
                isVerified =YES;
                if([[userDict objectForKey:P_DRIVER_AVAILAILITY] boolValue]==NO){
                    defaults_set_object(is_availability_on, @"0");
                }else{
                    defaults_set_object(is_availability_on, @"1");
                }
                if (isVerified==YES) {
                    [[NSUserDefaults standardUserDefaults]setObject:[userDict objectForKey:P_API_KEY] forKey:P_API_KEY];
                    [[NSUserDefaults standardUserDefaults]setObject:userDict  forKey:P_USER_DICT];
                    [[NSUserDefaults standardUserDefaults]synchronize];
                    [self updateDeviceToken];
                }
                else{
                    [UtilityClass setLH:YES wt:[LanguageHelper getStringWithKey:@"k_r30_s3_loading"]];
                    [self showWarningWithMessgae:[LanguageHelper getStringWithKey:@"k_d_msg_un_verified" defaultValue:@""]];
                }
            }
            
        }else if([[[results objectForKey:P_STATUS] uppercaseString] isEqualToString:@"ERROR"]){
            NSObject * userDictObject=[results objectForKey:@"response"];
            if([userDictObject isKindOfClass:[NSDictionary class]]){
                NSDictionary *userDict =(NSDictionary *)userDictObject;
                [self showAlertWithMessgae:[userDict objectForKey:@"message"]];
            }else{
                [self showAlertWithMessgae:[results objectForKey:@"message"]];
            }
        }
        else{
            NSDictionary *dictError=[Utilities handleErrorDict:error ];
            [UtilityClass setLH:YES wt:[LanguageHelper getStringWithKey:@"k_r30_s3_loading"]];
            if(dictError!=nil){
                [self showWarningWithMessgae:[dictError objectForKey:@"message"]];
            }else{
                [Utilities  handleError:error viewController:self.navigationController defaultMessage:@""];
            }
        }
    }];
}

-(void)updateDeviceToken{
    // update token in driver
    NSDictionary * dictDriver=defaults_object(P_USER_DICT);
    NSString * deviceToken=[[NSUserDefaults standardUserDefaults] objectForKey:P_DEVICE_TOKEN];
    NSMutableDictionary *dict = [NSMutableDictionary dictionaryWithDictionary:@{
        P_DRIVER_ID   :[NSString stringWithFormat:@"%d",[[dictDriver objectForKey:P_DRIVER_ID]intValue]],
        @"fire_password":default_fire_password
    }];
    if (deviceToken) {
        [dict addEntriesFromDictionary:@{
            P_D_DEVICE_TOKEN :deviceToken,
            P_D_DEVICE_TYPE   :IOS,
        }];
    }
    [dict addEntriesFromDictionary:[Utilities appBuildVersionAndOsInfo]];
    [GIC mkwu:UPDATE_DRIVER_PROFILE
            d:dict
          isa:NO
           cb:^(id results, NSError *error) {
        [UtilityClass setLH:YES wt:[LanguageHelper getStringWithKey:@"k_r30_s3_loading"]];
        if ([[[results objectForKey:P_STATUS] uppercaseString] isEqualToString:@"OK"]) {
            defaults_set_object(P_USER_DICT, [results objectForKey:P_RESPONSE]);
        }
        self.switchingToDriverMode = YES;
        defaults_set_object(P_IS_USER_LOGIN, @"0");
        NSDictionary * dictUser=defaults_object(P_USER_DICT_LOGGED);
        BOOL is_driver = [[dictUser objectForKey:@"is_driver"] boolValue];
        if(is_driver){
            [self openDriverHomeScreen:NO];
        }else{
            [self openDriverHomeScreen:YES];
        }
        self.switchingToDriverMode = NO;
    }];
}

-(void) getUserProfile{
    NSString *apiKey =[[NSUserDefaults standardUserDefaults]objectForKey:P_API_KEY];
    if (apiKey.length==0) {
        return;
    }
    NSMutableDictionary *dict = [NSMutableDictionary dictionaryWithDictionary:@{
        P_API_KEY :apiKey,
    }];
    [GIC mkwerwu:GET_USER_PROFILE
               d:dict
              cb:^(id results, NSError *error) {
        if ([[results objectForKey:P_STATUS] isEqualToString:@"OK"]) {
            NSDictionary * userDict;
            if([[results objectForKey:P_RESPONSE] isKindOfClass:[NSDictionary class ]]){
                userDict=[results objectForKey:P_RESPONSE];
                defaults_set_object(P_USER_DICT, userDict);
                defaults_set_object(P_USER_DICT_LOGGED, [results objectForKey:P_RESPONSE]);
                
            }else {
                if([[results objectForKey:P_RESPONSE] isKindOfClass:[NSArray class ]]) {
                    NSArray *arra=[results objectForKey:P_RESPONSE];
                    if(arra.count>0) {
                        userDict = [arra objectAtIndex:0];
                    }else {
                        defaults_remove(P_USER_DICT);
                        defaults_remove(P_API_KEY);
                        return ;
                    }
                }else{
                    defaults_remove(P_USER_DICT);
                    defaults_remove(P_API_KEY);
                    return ;
                }
            }
            defaults_set_object(P_API_KEY, [userDict objectForKey:P_API_KEY]);
            defaults_set_object(P_USER_DICT, userDict);
            defaults_set_object(P_USER_DICT_LOGGED, userDict);
            
            NSString *language=[userDict objectForKey:P_LANGUAGE];
            if(language!=nil&&language.length>0){
                [[NSUserDefaults standardUserDefaults] setObject:language forKey:@"language"];
                [[NSUserDefaults standardUserDefaults] synchronize];
                [[LanguageHelper  sharedInstance] setCunnrentLanguage:language];
                [[LanguageHelper  sharedInstance] configureLanguage];
            }
            [self updateDeviceTokenAsUser];
            defaults_set_object(P_IS_USER_LOGIN, @"1");
            [self loadUserHomeViewController];
        }
        else{
            if(results!=nil){
                if([[results objectForKey:@"code"] intValue]>=400){
                    defaults_remove(P_USER_DICT);
                    defaults_remove(P_API_KEY);
                }
            }else{
                NSData *data=[error.userInfo objectForKey:AppKeysName.ERROR_DATA];
                if(data){
                    NSError * jsonError=nil;
                    id json= [NSJSONSerialization JSONObjectWithData:data options:NSJSONReadingMutableContainers error:&jsonError];
                    if([json isKindOfClass:[NSDictionary class]]){
                        if([[json objectForKey:@"code"] intValue]>=400){
                            defaults_remove(P_USER_DICT);
                            defaults_remove(P_API_KEY);
                        }
                    }
                }
            }
        }
    }];
}
-(void)updateDeviceTokenAsUser{
    NSDictionary * dictUser=defaults_object(P_USER_DICT_LOGGED);
    NSString * deviceToken=[[NSUserDefaults standardUserDefaults] objectForKey:P_DEVICE_TOKEN];
    NSMutableDictionary *dict = [NSMutableDictionary dictionaryWithDictionary:@{
        P_USER_ID   :[NSString stringWithFormat:@"%d",[[dictUser objectForKey:P_USER_ID]intValue]],
    }];
    if (deviceToken) {
        [dict addEntriesFromDictionary:@{
            P_DEVICE_TOKEN :deviceToken,
            P_DEVICE_TYPE   :IOS,
        }];
    }
    [dict setObject:@"1" forKey:@"is_user_login"];
    [dict addEntriesFromDictionary:[Utilities appBuildVersionAndOsInfo]];
    [GIC mkwu:UPDATE_USER_PROFILE d:dict   isa:NO  cb:^(id results, NSError *error) {
        if ([[[results objectForKey:P_STATUS] uppercaseString] isEqualToString:@"OK"]) {
            BOOL is_user_login = [defaults_object(P_IS_USER_LOGIN) boolValue];
            if(is_user_login){
                defaults_set_object(P_USER_DICT, [results objectForKey:P_RESPONSE]);
            }
            defaults_set_object(P_USER_DICT_LOGGED, [results objectForKey:P_RESPONSE]);
        }
    }];
}
-(void)openDriverHomeScreen:(BOOL)isWithDocument{
    for (UIViewController *vc in self.navigationController.viewControllers) {
        if([vc isKindOfClass:[UHomeViewController class]]){
            UHomeViewController *homeVc=(UHomeViewController *) vc;
            [homeVc stopLocationUpdate];
        }
    }
    UINavigationController *navigationController = [StoryBoardUtiles navigationHome];
    if(isWithDocument){
        UploadDocumentViewController *documentVc =(UploadDocumentViewController *)[StoryBoardUtiles viewContollerWithIdentifier:StoryBoardUtiles.UPLOAD_DOCUMENT name:StoryBoardUtiles.STORYBOARD_SIGNUP ];
        HomeViewController *homeVc =(HomeViewController *)[StoryBoardUtiles viewContollerInMainWithIdentifier:StoryBoardUtiles.HOME_VC ];
        [navigationController setViewControllers:@[homeVc,documentVc]];
    }else{
        HomeViewController *homeVc =(HomeViewController *)[StoryBoardUtiles viewContollerInMainWithIdentifier:StoryBoardUtiles.HOME_VC ];
        [navigationController setViewControllers:@[homeVc]];
    }
    MainViewController *mainViewController =(MainViewController *)[StoryBoardUtiles viewContollerInMainWithIdentifier:StoryBoardUtiles.MAIN_VC ];
    // Force view load so LGSideMenuController view hierarchy exists before we set root/left
    (void)[mainViewController view];
    mainViewController.rootViewController = navigationController;
    // Use type 12: same "new menu" style as rider (UMainViewController type 2) — menu on top, dim overlay, content does not move, no shadow
    [mainViewController setupWithType:12];
    UIWindow *window = UIApplication.sharedApplication.delegate.window;
    window.rootViewController = mainViewController;
    self.driverSideMenuController = mainViewController;
    [UIView transitionWithView:window
                      duration:0.1
                       options:UIViewAnimationOptionTransitionCrossDissolve
                    animations:nil
                    completion:nil];
}


-(void)loadUserHomeViewController{
    self.switchingToDriverMode = NO;
    self.driverSideMenuController = nil;
    for (UIViewController *vc in self.navigationController.viewControllers) {
        if([vc isKindOfClass:[HomeViewController class]]){
            HomeViewController *homeVc=(HomeViewController *) vc;
            [homeVc stopLocationUpdate];
        }
    }
    UHomeViewController *homeVc =(UHomeViewController *)[StoryBoardUtiles viewContollerInUserWithIdentifier:StoryBoardUtiles.UHOME_VC ];
    UINavigationController *navigationController = [StoryBoardUtiles navigationHomeInUser];
    [navigationController setViewControllers:@[homeVc]];
    UMainViewController *mainViewController =(UMainViewController *)[StoryBoardUtiles viewContollerInUserWithIdentifier:StoryBoardUtiles.UMAIN_VC ];
    mainViewController.rootViewController = navigationController;
    [mainViewController setupWithType:2];
    UIWindow *window = UIApplication.sharedApplication.delegate.window;
    window.rootViewController = mainViewController;
    [UIView transitionWithView:window
                      duration:0.1
                       options:UIViewAnimationOptionTransitionCrossDissolve
                    animations:nil
                    completion:nil];
}


-(void) showWarningWithMessgae:(NSString *) message{
    [self showAlert:[LanguageHelper getStringWithKey:@"k_23_s3_warning"] message:message];
}

-(void) showAlertWithMessgae:(NSString *) message{
    [self showAlert:[LanguageHelper getStringWithKey:@"k_33_s7_alert"] message:message];
}


-(void) showAlert:(NSString *) title message:(NSString *) message
{
    UIAlertController *alertController = [UIAlertController alertControllerWithTitle:title
                                                                             message:message
                                                                      preferredStyle:UIAlertControllerStyleAlert];
    UIAlertAction *actionOk = [UIAlertAction actionWithTitle:[LanguageHelper getStringWithKey:@"k_18_s4_Ok"]
                                                       style:UIAlertActionStyleDefault
                                                     handler:nil]; //You can use a block here to handle a press on this button
    [alertController addAction:actionOk];
    [self.navigationController presentViewController:alertController animated:YES completion:nil];
}

-(void)startTimer{
    [self stopTimer];
    timerForOffScreen= [NSTimer scheduledTimerWithTimeInterval: 2.0
                                                        target: self
                                                      selector:@selector(onTick:)
                                                      userInfo: nil repeats:YES];
    NSRunLoop *runner = [NSRunLoop currentRunLoop];
    [runner addTimer: timerForOffScreen forMode: NSDefaultRunLoopMode];
}
-(void)stopTimer{
    if(timerForOffScreen){
        [timerForOffScreen invalidate];
        timerForOffScreen=nil;
    }
}
-(void)onTick:(NSTimer *)timer {
    [UIApplication sharedApplication].idleTimerDisabled = YES;
}


-(void)handleOfferNotification:(NSString *)tripId message:(NSString *)message userInfo:(NSDictionary *)userInfo{
    if([UIApplication sharedApplication].applicationState == UIApplicationStateActive){
        BOOL is_user_login = [defaults_object(P_IS_USER_LOGIN) boolValue];
        if(is_user_login){
            [[NSNotificationCenter defaultCenter] postNotificationName:AppNotificationName.USER_OFFER_NOTIFICATION object:nil userInfo:userInfo];
            return;
        }else{
            
        }
    }
    UIAlertController *alertController = [UIAlertController alertControllerWithTitle:@""          message:message                                    preferredStyle:UIAlertControllerStyleAlert];
    UIAlertAction *actionOkCancel = [UIAlertAction actionWithTitle:[LanguageHelper getStringWithKey:@"k_30_s6_cancel_j" defaultValue:@"Cancel"]
                                                             style:UIAlertActionStyleDefault
                                                           handler:nil];
    [alertController addAction:actionOkCancel];
    UIAlertAction *actionOk = [UIAlertAction actionWithTitle:[LanguageHelper getStringWithKey:@"Open" defaultValue:@"Ok"]
                                                       style:UIAlertActionStyleDefault
                                                     handler:^(UIAlertAction * _Nonnull action) {
        
        BOOL is_user_login = [defaults_object(P_IS_USER_LOGIN) boolValue];
        if(is_user_login){
            [[NSNotificationCenter defaultCenter] postNotificationName:AppNotificationName.USER_OFFER_NOTIFICATION object:nil userInfo:userInfo];
        }else{
            [self.navigationController popToRootViewControllerAnimated:NO];
            if([self.navigationController.topViewController isKindOfClass:[HomeViewController class]]){
                HomeViewController *homeVc=(HomeViewController *)self.navigationController.topViewController;
                [homeVc onOpenRequestButtonTap:nil];
            }
        }
    }];
    [alertController addAction:actionOk];
    
    UIViewController * viewController=[self.navigationController topViewController];
    if(!([viewController isKindOfClass:[TripOffersViewContoller class]]||[viewController isKindOfClass:[DTripOffersViewContoller class]]))   {
        //        [self.navigationController.topViewController presentViewController:alertController animated:YES completion:nil];
        if([self.navigationController.topViewController.presentedViewController isKindOfClass:[UIAlertController class]]){
            [self.navigationController.topViewController.presentedViewController dismissViewControllerAnimated:NO completion:^{
                [self.navigationController.topViewController presentViewController:alertController animated:YES completion:nil];
            }];
        }else{
            [self.navigationController.topViewController presentViewController:alertController animated:YES completion:nil];
        }
        if([UIApplication sharedApplication].applicationState == UIApplicationStateBackground){
            [[NSNotificationCenter defaultCenter]
             postNotificationName:AppNotificationName.USER_OFFER_NOTIFICATION
             object:nil userInfo:userInfo];
        }
    }else{
        [[NSNotificationCenter defaultCenter]
         postNotificationName:AppNotificationName.USER_OFFER_NOTIFICATION
         object:nil userInfo:userInfo];
    }
}


