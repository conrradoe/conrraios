- (void)application:(UIApplication *)application didReceiveRemoteNotification:(NSDictionary *)userInfo fetchCompletionHandler:(void (^)(UIBackgroundFetchResult))completionHandler
{
    
    if (application.applicationState == UIApplicationStateBackground) {
        
        
        NSString* contentAvailable = [NSString stringWithFormat:@"%@", [[userInfo valueForKey:@"aps"] valueForKey:@"content-available"]];
        
        if([contentAvailable isEqualToString:@"1"]) {
            // do tasks
            //            [self manageRemoteNotification:userInfo application:application];
            [self manageRemoteNotification:[self mapUserInfoFcmToApns:userInfo] application:application];
            completionHandler(UIBackgroundFetchResultNewData);
        }
    }
    else {
        
        //Show an in-app banner
        //do tasks
        //        [self manageRemoteNotification:userInfo application:application];
        [self manageRemoteNotification:[self mapUserInfoFcmToApns:userInfo] application:application];
        completionHandler(UIBackgroundFetchResultNewData);
        
    }
}

- (void)application:(UIApplication *)application didRegisterForRemoteNotificationsWithDeviceToken:(NSData *) deviceToken {
    
    [FIRMessaging messaging].APNSToken = deviceToken;
    NSString *strDeviceToken;
    if (SYSTEM_VERSION_GREATER_THAN_OR_EQUAL_TO(@"13.0")) {
        strDeviceToken = [self hexadecimalStringFromData:deviceToken];
    }
    else {
        strDeviceToken =
        [[[[deviceToken description] stringByReplacingOccurrencesOfString:@"<"
                                                               withString:@""]
          stringByReplacingOccurrencesOfString:@">"
          withString:@""]
         stringByReplacingOccurrencesOfString:@" "
         withString:@""];
        
    }
    
    //    NSLog(@"Device token  %@", strDeviceToken);
    //    [[NSUserDefaults standardUserDefaults]setObject:strDeviceToken forKey:P_DEVICE_TOKEN];
    //    [[NSUserDefaults standardUserDefaults]synchronize];
    
}

- (NSString *)hexadecimalStringFromData:(NSData *)data
{
    NSUInteger dataLength = data.length;
    if (dataLength == 0) {
        return nil;
    }
    
    const unsigned char *dataBuffer = (const unsigned char *)data.bytes;
    NSMutableString *hexString  = [NSMutableString stringWithCapacity:(dataLength * 2)];
    for (int i = 0; i < dataLength; ++i) {
        [hexString appendFormat:@"%02x", dataBuffer[i]];
    }
    return [hexString copy];
}


-(void)manageRemoteNotification:(NSDictionary *)userInfo application:(UIApplication *)application{
    if(userInfo.count==0){
        return;
    }
    NSMutableDictionary *dicAps=[userInfo valueForKey:@"aps"];
    NSString * to =[dicAps objectForKey:@"to"];
    NSString * type =[dicAps objectForKey:@"type"];
    if(type.length>0){
        SystemSoundID completeSound;
        NSURL *audioPath = [[NSBundle mainBundle] URLForResource:@"Alert" withExtension:@"mp3"];
        AudioServicesCreateSystemSoundID((__bridge CFURLRef)audioPath, &completeSound);
        AudioServicesPlaySystemSound (completeSound);
        if([type isEqualToString:@"wallet_notif"]){
            [self refreshUserProfile];
        }else{
            [[NSNotificationCenter defaultCenter]
             postNotificationName:@"noti_refresh"
             object:nil userInfo:userInfo];
            [self handleSideNotificationWithMessage:[dicAps objectForKey:@"alert"]];
        }
        return;
    }
    if(type.length>0){
        [self openAlertNotificationDebug:[NSString stringWithFormat:@"%@",userInfo] ];
        return;
    }
    if(to.length==0){
        NSString * tripStatus = [dicAps objectForKey:TRIP_STATUS];
        if([tripStatus isEqualToString:TS_ASSIGNED]||[tripStatus isEqualToString:TS_REQUEST]){
            to = @"driver";
        }else{
            //[self openAlertNotificationDebug:[NSString stringWithFormat:@"%@",userInfo] ];
            return;
        }
    }
    
    
    BOOL isUserLogin=[defaults_object(P_IS_USER_LOGIN) boolValue];
    if(isUserLogin==YES){
        if(![to isEqualToString:@"user"]){
            [self openAlertNotificationDifferentType:[LanguageHelper getStringWithKey:@"k_76_s4_crs_app_noti_rdr"]];
            return;
        }
        
    }else{
        if(![to isEqualToString:@"driver"]){
            [self openAlertNotificationDifferentType:[LanguageHelper getStringWithKey:@"k_76_s4_crs_app_noti_drvr"]];
            return;
        }
    }
    
    if(to.length>0&&[to isEqualToString:@"user"]){
        [self manageRemoteNotificationUser:userInfo application:application];
        return;
    }
    
    
    if (application.applicationState == UIApplicationStateActive) {
        if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_RIDER_CANCEL])
        {
            SystemSoundID completeSound;
            NSURL *audioPath = [[NSBundle mainBundle] URLForResource:@"driver_cancel" withExtension:@"caf"];
            AudioServicesCreateSystemSoundID((__bridge CFURLRef)audioPath, &completeSound);
            AudioServicesPlaySystemSound (completeSound);
        }else{
            if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_REQUEST]){
                [self stopRequestSound];
                NSURL *audioPath = [[NSBundle mainBundle] URLForResource:@"request_sound" withExtension:@"caf"];
                AudioServicesCreateSystemSoundID((__bridge CFURLRef)audioPath, &completeSoundRequest);
                AudioServicesPlaySystemSound (completeSoundRequest);
            }else if([[dicAps objectForKey:@"trip_status"] isEqualToString:@"hide_alert"]){
                
            }
            else{
                SystemSoundID completeSound;
                NSURL *audioPath = [[NSBundle mainBundle] URLForResource:@"Alert" withExtension:@"mp3"];
                AudioServicesCreateSystemSoundID((__bridge CFURLRef)audioPath, &completeSound);
                AudioServicesPlaySystemSound (completeSound);
                
            }
        }
    }
    
    if([[dicAps objectForKey:@"trip_status"] isEqualToString:@"hide_alert"]){
        NSString *tripId= defaults_object(TRIP_ID);
        if([tripId intValue ]>0){
            if([tripId intValue]==[[dicAps objectForKey:@"trip_id"] intValue]){
                defaults_remove(TRIP_ID);
                defaults_remove(TRIP_STATUS);
            }
        }
        [self stopRequestSound];
        [[NSNotificationCenter defaultCenter]
         postNotificationName:AppNotificationName.DRIVER_HIDE_ALERT_NOTIFICATION
         object:nil userInfo:userInfo];
    }
    else if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_RIDER_CANCEL_CANCEL]){
        
        [self handleRiderCancelNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"]];
    }
    else if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_CHAT]){
        [self handleChatNotification:dicAps ];
    }
    else if ([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_OFFER]) {
        [self handleOfferNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"] userInfo:userInfo];
    }
    else if ([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_REQUEST] || [[dicAps objectForKey:@"trip_status"] isEqualToString:TS_RIDER_CANCEL] ) {
        [[NSNotificationCenter defaultCenter]
         postNotificationName:AppNotificationName.DRIVER_ACCEPT_NOTIFICATION
         object:nil userInfo:userInfo];
    }
    else if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_ARRIVE]) {
        [self handleTripRunninNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"] tripStatus:[dicAps objectForKey:@"trip_status"]];
    }
    else if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_BEGIN]) {
        [self handleTripRunninNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"] tripStatus:[dicAps objectForKey:@"trip_status"]];
    }
//    else if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_ACCEPTED]) {
//        [self handleTripRunninNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"] tripStatus:[dicAps objectForKey:@"trip_status"]];
//    }
    else if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_END]) {
        [self handleTripRunninNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"] tripStatus:[dicAps objectForKey:@"trip_status"]];
    }
    else if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_ASSIGNED]) {
        [self handleTripRunninNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"] tripStatus:[dicAps objectForKey:@"trip_status"]];
    }else if ([[dicAps objectForKey:@"trip_status"] isEqualToString:@"declined"]) {
        [[NSNotificationCenter defaultCenter] postNotificationName:AppNotificationName.USER_OFFER_NOTIFICATION object:nil userInfo:userInfo];
        //        [self handleOfferNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"] userInfo:userInfo];
    }
    else if ([[dicAps objectForKey:@"trip_status"] isEqualToString:CASH_PAY] || [[dicAps objectForKey:@"trip_status"] isEqualToString:PAYPAL_PAY]){
        [[NSNotificationCenter defaultCenter]
         postNotificationName:AppNotificationName.DRIVER_RECEIVEDATFARE_NOTIFICATION
         object:nil userInfo:userInfo];
        UINavigationController *navController = (UINavigationController *)self.window.rootViewController.navigationController.viewControllers;
        
        UIViewController *currentControllerName = [navController topViewController];
        if(![currentControllerName  isKindOfClass:[FareAmmountViewController class]])  {
            [self handleCashNotification:[dicAps objectForKey:@"trip_id"]  message:[dicAps objectForKey:@"alert"]];
        }
    }else  if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_ACCEPTED]){
        defaults_set_object(TRIP_ID, isEmpty([dicAps objectForKey:@"trip_id"]));
        [self stopRequestSound];
        [self handleAcceptNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"] userInfo:userInfo];
    }else{
        //        [self openAlertNotificationDebug:[NSString stringWithFormat:@"Else Condition %@",dicAps] ];
    }
    
    
    
    UINavigationController *navController = (UINavigationController *)self.window.rootViewController.navigationController.viewControllers;
    
    UIViewController *currentControllerName = [navController topViewController];
    
    
    NSString *status =defaults_object(DRIVER_STATUS);
    
    if([status isEqualToString:TS_WAITING] && ![currentControllerName  isKindOfClass:[HomeViewController class]]) {
        [currentControllerName.navigationController popToRootViewControllerAnimated:NO];
    }
}


-(void) handleChatNotification:(NSDictionary *)dicAps{
    NSString * type =[dicAps objectForKey:@"type"];
    NSString * to =[dicAps objectForKey:@"to"];
    BOOL isUserLogin=[defaults_object(P_IS_USER_LOGIN) boolValue];
    if(isUserLogin==YES){
        if([to isEqualToString:@"user"]){
            if(![self.navigationController.topViewController isKindOfClass:[BeginTripViewController class]]){
//                [pushNotificationHandler handleChatNotificationWithMessage:[dicAps objectForKey:@"alert"] tripId:[dicAps objectForKey:@"trip_id"] ];
                [self handleChatNotificationMSG:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"]];
            }
        }else{
            [self openAlertNotificationDifferentType:[LanguageHelper getStringWithKey:@"k_76_s4_crs_app_noti_rdr"]];
        }
    }else{
        if([to isEqualToString:@"driver"]){
            if(![self.navigationController.topViewController isKindOfClass:[HomeViewController class]]){
//                [pushNotificationHandler handleChatNotificationWithMessage:[dicAps objectForKey:@"alert"] tripId:[dicAps objectForKey:@"trip_id"] ];
                [self handleChatNotificationMSG:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"]];
            }
            return;
        }else{
            [self openAlertNotificationDifferentType:[LanguageHelper getStringWithKey:@"k_76_s4_crs_app_noti_rdr"]];
        }
    }
    
}


-(void ) handleChatNotificationMSG:(NSString *) tripId message:(NSString *) message{
    UIAlertController *alertController = [UIAlertController alertControllerWithTitle:[LanguageHelper getStringWithKey:@"k_97_s4_msg_revd" ]     message:message   preferredStyle:UIAlertControllerStyleAlert];
   
    UIAlertAction *actionOkCancel = [UIAlertAction actionWithTitle:[LanguageHelper getStringWithKey:@"k_30_s6_cancel_j"]
                                                             style:UIAlertActionStyleDefault
                                                           handler:nil];
    [alertController addAction:actionOkCancel];
    UIAlertAction *actionOk = [UIAlertAction actionWithTitle:[LanguageHelper getStringWithKey:@"k_18_s4_vw_cht"]
                                                       style:UIAlertActionStyleDefault
                                                     handler:^(UIAlertAction * _Nonnull action) {
        [self openChatViewController:tripId];
    }];
    [alertController addAction:actionOk];
    UIViewController * viewController=[self.navigationController topViewController];
    if(![viewController isKindOfClass:[ChatViewController class]])  {
        [self presentViewControllerCustom:alertController];
        autoHideChat=[[AutoHideAlert alloc] init];
        [autoHideChat handle:alertController];
        autoHideChat.delegate=self;
    }
}
-(void) openChatViewController:(NSString *) tripId{
    ChatViewController *vc = (ChatViewController*)[StoryBoardUtiles viewContollerInMainWithIdentifier:StoryBoardUtiles.CHAT_VC];
    vc.tripID=tripId;
    [self.navigationController pushViewController:vc animated:YES];
}


-(void)manageRemoteNotificationUser:(NSDictionary *)userInfo application:(UIApplication *)application{
    NSMutableDictionary *dicAps=[userInfo valueForKey:@"aps"];
    NSString * type =[dicAps objectForKey:@"type"];
    if(type.length>0){
        if([type isEqualToString:@"wallet_notif"]){
            [self refreshUserProfile];
        }else{
            [[NSNotificationCenter defaultCenter]
             postNotificationName:@"noti_refresh"
             object:nil userInfo:userInfo];
            [self handleSideNotificationWithMessage:[dicAps objectForKey:@"alert"]];
        }
        return;
    }
    if (application.applicationState == UIApplicationStateActive) {
        
        if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_ARRIVE]){
            SystemSoundID completeSound;
            NSURL *audioPath = [[NSBundle mainBundle] URLForResource:@"cab_arrive" withExtension:@"caf"];
            AudioServicesCreateSystemSoundID((__bridge CFURLRef)audioPath, &completeSound);
            AudioServicesPlaySystemSound (completeSound);
        }else{
            SystemSoundID completeSound;
            NSURL *audioPath = [[NSBundle mainBundle] URLForResource:@"Alert" withExtension:@"mp3"];
            AudioServicesCreateSystemSoundID((__bridge CFURLRef)audioPath, &completeSound);
            AudioServicesPlaySystemSound (completeSound);
        }
        
    }
    if([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_CHAT]) {
        [self handleChatNotification:dicAps];
  
        return;
    }
    if ([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_ACCEPTED]) {
        [[NSNotificationCenter defaultCenter] postNotificationName:AppNotificationName.USER_ON_ACCEPT_NOTIFICATION object:nil userInfo:userInfo];
    } else if ([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_OFFER]) {
        //        [[NSNotificationCenter defaultCenter] postNotificationName:AppNotificationName.USER_OFFER_NOTIFICATION object:nil userInfo:userInfo];
        [self handleOfferNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"] userInfo:userInfo];
    } else if ([[dicAps objectForKey:@"trip_status"] isEqualToString:@"declined"]) {
        [[NSNotificationCenter defaultCenter] postNotificationName:AppNotificationName.USER_OFFER_NOTIFICATION  object:nil userInfo:userInfo];
    }
    else{
        [[NSNotificationCenter defaultCenter] postNotificationName:AppNotificationName.USER_ACCEPT_NOTIFICATION  object:nil userInfo:userInfo];
    }
    if ([[dicAps objectForKey:@"trip_status"] isEqualToString:TS_PAID]||[[dicAps objectForKey:@"trip_status"] isEqualToString:TS_PAID]) {
        UINavigationController *navController = (UINavigationController *)self.window.rootViewController.navigationController.viewControllers;
        UIViewController *currentControllerName = [navController topViewController];
        if(![currentControllerName  isKindOfClass:[FareAmmountViewController class]]) {
            [self handleCashNotification:[dicAps objectForKey:@"trip_id"] message:[dicAps objectForKey:@"alert"]];
        }
    }
}
/**
 * This method validates whether the internet is reachable or  not
 */
- (void)checkNetworkStatus:(NSNotification *)notice {
    // called after network status changes
    NetworkStatus internetStatus = [internetReachable currentReachabilityStatus];
    switch (internetStatus) {
        case NotReachable: {
            
            if (self.connectionStatus) {
                [UtilityClass swa:[LanguageHelper getStringWithKey:@"k_5_s10_internet_error"]
                                m:[LanguageHelper getStringWithKey:@"k_5_s10_internet_error"]
                              cbt:[LanguageHelper getStringWithKey:@"k_18_s4_Ok"]
                              obt:nil
                ];
                
            }
            
            self.connectionStatus = FALSE;
            break;
        }
        case ReachableViaWiFi:
        case ReachableViaWWAN: {
            self.connectionStatus = TRUE;
            
            break;
        }
    }
}


 




-(void ) handleCashNotification:(NSString *) tripId message:(NSString *) message{
    NSString * string=[LanguageHelper getStringWithKey:@"k_17_s8_payment_com"];
    NSString *stringFinal = [string
                             stringByReplacingOccurrencesOfString:@"%s" withString:@"%@"];
    message=[NSString stringWithFormat:stringFinal,tripId];
    UIAlertController *alertController = [UIAlertController alertControllerWithTitle:@""
                                                                             message:message                                                                         preferredStyle:UIAlertControllerStyleAlert];
    UIAlertAction *actionOkCancel = [UIAlertAction actionWithTitle:[LanguageHelper getStringWithKey:@"k_18_s4_Ok"]
                                                             style:UIAlertActionStyleDefault
                                                           handler:^(UIAlertAction * _Nonnull action) {
        [self stopDissmissTimerAlert];
    }];
    [alertController addAction:actionOkCancel];
    UIViewController * viewController=[self.navigationController topViewController];
    if(![viewController isKindOfClass:[FareAmmountViewController class]]){
        alertAutoHide=alertController;
        [self.navigationController.topViewController presentViewController:alertController animated:YES completion:^{
            [self setDissmissTimerAlert];
        }];
    }
}

-(void)setDissmissTimerAlert{
    [self stopDissmissTimerAlert];
    timerForHideAlert = [NSTimer scheduledTimerWithTimeInterval: 10 target: self
                                                       selector: @selector(dissmissTimerAlertCalled) userInfo: nil repeats: NO];
}
-(void)stopDissmissTimerAlert{
    if(timerForHideAlert){
        [timerForHideAlert invalidate];
        timerForHideAlert=nil;
    }
}
-(void)dissmissTimerAlertCalled{
    if(alertAutoHide!=nil){
        [alertAutoHide  dismissViewControllerAnimated:YES completion:^{
            self->alertAutoHide=nil;
            [self stopDissmissTimerAlert];
        }];
    }
}

